<?xml version="1.0" encoding="utf-8"?>
<mdscript name="Station_Storage_Allocation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../libraries/md.xsd">
  <cues>

    <cue name="Init" instantiate="false" version="1">
      <cues>

        <!-- ── Config initialisation ────────────────────────────────────── -->
        <!-- Loads player.entity.$stationStorageAllocation, creating it with defaults if
             absent. Sets $config as a local alias. Callers must remove_value
             $config when done. -->
        <library name="Get_Config" purpose="include_actions" version="2">
          <actions>
            <do_if value="@player.entity.$stationStorageAllocation == null">
              <set_value name="player.entity.$stationStorageAllocation" exact="table[
                $stockRefreshInterval  = 3,
                $alwaysIndividualEdit  = false,
              ]" />
            </do_if>
            <do_if value="player.entity.$stationStorageAllocation.$stockRefreshInterval? == false">
              <set_value name="player.entity.$stationStorageAllocation.$stockRefreshInterval" exact="3" />
            </do_if>
            <do_if value="player.entity.$stationStorageAllocation.$alwaysIndividualEdit? == false">
              <set_value name="player.entity.$stationStorageAllocation.$alwaysIndividualEdit" exact="false" />
            </do_if>
            <set_value name="$config" exact="player.entity.$stationStorageAllocation" />
          </actions>
        </library>

        <!-- ── Options menu registration ───────────────────────────────── -->
        <cue name="Register_Menu" instantiate="true" version="1">
          <conditions>
            <event_cue_signalled cue="md.Simple_Menu_API.Reloaded" />
          </conditions>
          <actions>
            <signal_cue_instantly cue="md.Simple_Menu_API.Register_Options_Menu"
              param="table[
                $id      = 'station_storage_allocation_options',
                $columns = 12,
                $title   = {1972092419, 90001},
                $onOpen  = Options_Menu_Open,
              ]" />
          </actions>
        </cue>

        <!-- ── Options menu content ─────────────────────────────────────── -->
        <cue name="Options_Menu_Open" instantiate="true" version="2">
          <conditions>
            <event_cue_signalled />
          </conditions>
          <actions>
            <include_actions ref="Get_Config" />

            <include_actions ref="md.Options_Helper.Add_Empty_Row" />

            <run_actions ref="md.Options_Helper.Add_Checkbox">
              <param name="id" value="'alwaysIndividualEdit'" />
              <param name="col" value="1" />
              <param name="textColSpan" value="11" />
              <param name="text" value="{1972092419, 90012}" />
              <param name="data" value="$config" />
              <param name="handle" value="Handle_Checkbox_Changed" />
            </run_actions>

            <include_actions ref="md.Options_Helper.Add_Empty_Row" />

            <run_actions ref="md.Options_Helper.Add_Slider">
              <param name="id" value="'stockRefreshInterval'" />
              <param name="min" value="1" />
              <param name="max" value="10" />
              <param name="step" value="1" />
              <param name="text" value="{1972092419, 90011}" />
              <param name="colSpan" value="12" />
              <param name="data" value="$config" />
              <param name="handle" value="Handle_Slider_Changed" />
            </run_actions>

            <remove_value name="$config" />
          </actions>
        </cue>

        <!-- ── Slider change handler ────────────────────────────────────── -->
        <cue name="Handle_Slider_Changed" instantiate="true" version="1">
          <conditions>
            <event_cue_signalled />
          </conditions>
          <actions>
            <include_actions ref="Get_Config" />
            <set_value name="$resultTable" exact="$config" />
            <include_actions ref="md.Options_Helper.Process_Slider_Changed" />
            <remove_value name="$resultTable" />
            <!-- Notify the Lua side so it picks up the new value immediately -->
            <raise_lua_event name="'SSA.ConfigChanged'" />
            <remove_value name="$config" />
          </actions>
        </cue>

        <!-- ── Checkbox change handler ──────────────────────────────────── -->
        <cue name="Handle_Checkbox_Changed" instantiate="true" version="1">
          <conditions>
            <event_cue_signalled />
          </conditions>
          <actions>
            <include_actions ref="Get_Config" />
            <set_value name="$resultTable" exact="$config" />
            <include_actions ref="md.Options_Helper.Process_Checkbox_Changed" />
            <remove_value name="$resultTable" />
            <!-- Notify the Lua side so it picks up the new value immediately -->
            <raise_lua_event name="'SSA.ConfigChanged'" />
            <remove_value name="$config" />
          </actions>
        </cue>

      </cues>
    </cue>

  </cues>
</mdscript>